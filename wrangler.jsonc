
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "fe2-map-creation-audio-io",
    "main": "src/index.js",
    "compatibility_date": "2026-10-06",
    "assets": {
        "directory": ".",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "invocation_logs": true
        },
        "traces": {
            "enabled": false
        }
    },
    "kv_namespaces": [
        {
            "binding": "ACCOUNT_DATA",
            "id": "f26fb57650c747308abfc0ddba46a3af"
        },
        {
            "binding": "EVENTS",
            "id": "a159c3950477422ca8de479a00234f77"
        }
    ]
}